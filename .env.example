# === LLM API Configuration ===
# Provide EITHER an OpenAI API key (sk-...) OR a Google Gemini API key (AIzaSy...)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model configuration:
# For OpenAI: gpt-4o-mini, gpt-4o, etc.
# For Gemini: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro, etc.
OPENAI_MODEL=gpt-4o-mini

# Optional custom OpenAI-compatible base URL (auto-set for Gemini):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# === Vector Store & Ingestion ===
CHROMA_PATH=chroma_db
UPLOAD_DIR=data/uploads
CHROMA_COLLECTION=securerag_documents
TOP_K=4
RETRIEVAL_CANDIDATE_K=12
SIMILARITY_THRESHOLD=0.35
CITATION_EXCERPT_CHARS=350
CHUNK_SIZE=900
CHUNK_OVERLAP=150
LOG_LEVEL=INFO

# === Advanced Search & Memory ===
ENABLE_HYBRID_SEARCH=true
ENABLE_QUERY_EXPANSION=false
ENABLE_STREAMING=true
MAX_HISTORY_MESSAGES=10
ENABLE_QUERY_RECONTEXTUALIZATION=true
